{
  "schema_version": 1,
  "kind": "story-choreography",
  "id": "checkout-receipt-handoff",
  "title": "Take email off the checkout path",
  "preset": "signal-flow",
  "chrome": "story",
  "badge": "PR WALKTHROUGH",
  "statusBadges": "none",
  "duration": 10.5,
  "loop": true,
  "stills": [
    2.5,
    5.5,
    10.15
  ],
  "views": [
    {
      "id": "before",
      "type": "architecture",
      "input": "checkout-before.json",
      "preset": "classic"
    },
    {
      "id": "after",
      "type": "architecture",
      "input": "checkout-after.json",
      "callouts": {
        "queue": {
          "text": "NEW",
          "tone": "added"
        },
        "worker": {
          "text": "NEW",
          "tone": "added"
        }
      },
      "preset": "signal-flow"
    }
  ],
  "steps": [
    {
      "view": "before",
      "at": 0,
      "duration": 3.2,
      "title": "Checkout waits on email",
      "body": "The API waits for the email provider before returning.",
      "badge": "BEFORE",
      "tone": "removed",
      "trace": {
        "edges": [
          "checkout_request",
          "blocking_send"
        ],
        "travel": 0.65
      }
    },
    {
      "view": "after",
      "at": 3.2,
      "duration": 3.1,
      "title": "Same endpoint, shorter path",
      "body": "Checkout returns once the queue accepts the receipt job.",
      "badge": "AFTER",
      "tone": "modified",
      "enter": [
        "queue"
      ],
      "connect": [
        "enqueue"
      ],
      "trace": {
        "edges": [
          "enqueue"
        ],
        "travel": 0.7
      }
    },
    {
      "view": "after",
      "at": 6.3,
      "duration": 4.2,
      "title": "The worker sends the receipt",
      "body": "The worker delivers email in the background, outside checkout.",
      "badge": "AFTER",
      "tone": "added",
      "enter": [
        "worker"
      ],
      "connect": {
        "edges": [
          "consume",
          "deliver"
        ],
        "stagger": 0.28
      },
      "trace": {
        "edges": [
          "consume",
          "deliver"
        ],
        "travel": 0.65
      }
    }
  ],
  "pair": {
    "before": "before",
    "after": "after",
    "at": 3.2,
    "duration": 0.85,
    "shared": [
      {
        "id": "storefront"
      },
      {
        "id": "checkout"
      },
      {
        "id": "provider"
      }
    ]
  },
  "fade": [
    {
      "view": "before",
      "edges": [
        "blocking_send"
      ],
      "at": 3.05,
      "to": 0
    }
  ]
}
